		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"dexie": "^4.4.6",
		"pitchy": "^4.1.0",
		"ts-fsrs": "^5.4.2",
		"vexflow": "5.0.0"
