    "target": "{root}",
  },
  "round": {
    "expectations": [
      {
        "at": {
          "beats": 0,
        },
        "content": {
          "from": "voicing-root",
        },
        "sensor": "note",
        "window": {
          "ms": {
            "param": "windows.perfectMs",
          },
        },
      },
      {
        "at": {
          "beats": {
            "param": "windows.anchorChordFromBeats",
          },
        },
        "content": {
          "from": "voicing-anywhere",
        },
        "sensor": "chord",
        "until": {
          "bars": 1,
        },
        "window": {
          "ms": {
            "param": "windows.perfectMs",
          },
        },
      },
    ],
    "length": {
      "bars": 1,
      "breath": true,
    },
    "policy": {
      "correction": true,
      "pairing": {
        "lateCapture": {
          "ms": {
            "param": "windows.lateCaptureMs",
          },
        },
        "lateMs": {
          "param": "windows.lateMs",
        },
        "mode": "first-answer",
        "opens": {
          "afterPromptMs": {
            "param": "windows.minResponseMs",
          },
        },
      },
      "unit": "response",
      "verdict": "response",
    },
    "prompt": {
      "lead": {
        "param": "leadBeats",
      },
    },
  },
  "tempo": 80,
  "view": "lane",
}
`;

